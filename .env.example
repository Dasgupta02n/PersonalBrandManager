# Public app URL (used for links in sign-in emails and redirects)
APP_URL=http://localhost:3000

# Our own PostgreSQL. In production these are built by deploy/app.compose.yml from
# POSTGRES_PASSWORD and PBM_APP_PASSWORD; locally, point them at your own database.
DATABASE_URL=postgres://pbm_app:local-password@127.0.0.1:5432/pbm
# Used only by `npm run db:migrate` (superuser), together with PBM_APP_PASSWORD.
DATABASE_ADMIN_URL=postgres://postgres@127.0.0.1:5432/pbm
PBM_APP_PASSWORD=local-password-16chars

# Keys the hashes of sign-in codes, links and session tokens: 32+ random characters
# (openssl rand -hex 24). Changing it signs everyone out.
AUTH_SECRET=

# Sign-in emails from hello@c7xai.in (Hostinger SMTP). Leave the password empty locally:
# the code is printed in the server log instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@c7xai.in
SMTP_PASSWORD=
# Optional sender shown in the inbox; defaults to the product name and SMTP_USER
# MAIL_FROM="Product name <hello@c7xai.in>"

# OpenRouter API key (server-only); all AI calls go through OpenRouter
OPENROUTER_API_KEY=
# Optional per-task model overrides (OpenRouter model ids); defaults are in src/lib/ai/models.ts
# AI_MODEL_EXTRACT_WINS=anthropic/claude-opus-5.5

# Shared secret for the scheduler endpoint (/api/cron/tick)
CRON_SECRET=

# Production only (deploy/app.compose.yml): the database superuser, and the backup passphrase.
# Keep a copy of BACKUP_PASSPHRASE off the server; without it no backup can be restored.
# POSTGRES_PASSWORD=
# BACKUP_PASSPHRASE=
# BACKUP_DRIVE_FOLDER=pbm-backups
