# Public app URL (used for auth redirects and links in messages)
APP_URL=http://localhost:3000

# Supabase project (Settings > API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (never expose to the browser)
SUPABASE_SECRET_KEY=

# Claude API (server-only)
ANTHROPIC_API_KEY=
# Optional per-task model overrides; every task defaults to claude-opus-5-5
# AI_MODEL_EXTRACT_WINS=
# AI_MODEL_POST_IDEAS=
# AI_MODEL_DRAFT_POST=
# AI_MODEL_CHECK_DRAFT=
# AI_MODEL_DRAFT_COMMENTS=

# Shared secret for the scheduler endpoint (/api/cron/tick)
CRON_SECRET=
