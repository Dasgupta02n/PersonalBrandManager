# Public app URL (used for auth redirects and links in messages)
APP_URL=http://localhost:3000

# Supabase project (Settings > API)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secret key (never expose to the browser)
SUPABASE_SECRET_KEY=

# OpenRouter API key (server-only); all AI calls go through OpenRouter
OPENROUTER_API_KEY=
# Optional per-task model overrides (OpenRouter model ids); defaults are in src/lib/ai/models.ts
# AI_MODEL_EXTRACT_WINS=anthropic/claude-opus-5.5

# Shared secret for the scheduler endpoint (/api/cron/tick)
CRON_SECRET=
